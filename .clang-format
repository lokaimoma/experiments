BasedOnStyle: LLVM
IndentWidth: 4
TabWidth: 4
UseTab: Never

# --- Fix function argument wrapping ---
# Prevent packing mixed numbers of arguments on random lines
BinPackArguments: false
BinPackParameters: false

# Horizontal alignment style after an opening '('
# 'false' keeps arguments indented cleanly via ContinuationIndentWidth
AlignAfterOpenBracket: true
ContinuationIndentWidth: 4

# Increase this if your code wraps just because lines are slightly long
# ColumnLimit: 100
